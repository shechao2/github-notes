# 数据库位置（默认 data/app.db）
A4S_DB=

# 置信度阈值：>= 直接回答；[追问线, 阈值) 追问；< 追问线 不猜、转人工
A4S_CONF_THRESHOLD=0.62
A4S_CLARIFY_THRESHOLD=0.30

# 检索返回条数
A4S_TOP_K=5

# M2：接入大模型（当前默认规则拼接）
A4S_LLM=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
A4S_LLM_MODEL=deepseek-chat

# M2：飞书多维表格（自建应用 + 多维表格）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_TABLE_ID=
